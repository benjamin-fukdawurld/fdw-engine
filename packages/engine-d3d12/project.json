{
  "name": "engine-d3d12",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/engine-d3d12/src",
  "projectType": "library",
  "tags": ["gpu"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/*.node",
          "transitive": true
        },
        {
          "env": "FDW_REQUIRE_SUITES"
        },
        {
          "env": "FDW_D3D12_ADAPTER"
        }
      ],
      "dependsOn": ["build-native"]
    },
    "build-native": {
      "command": "node scripts/build.mjs",
      "options": {
        "cwd": "packages/engine-d3d12"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/native/**/*",
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/tools/native/**/*",
        {
          "externalDependencies": ["node-api-headers"]
        },
        {
          "env": "FDW_FROM_SOURCE"
        },
        {
          "runtime": "node tools/native/prebuilt.mjs windows-sdk"
        }
      ],
      "outputs": [
        "{projectRoot}/build/fdw_d3d12.node",
        "{projectRoot}/build/.prebuilt",
        "{projectRoot}/build/dxcompiler.dll",
        "{projectRoot}/build/dxil.dll"
      ],
      "configurations": {
        "debug": {
          "args": "--debug"
        }
      }
    }
  }
}
