{
  "name": "engine-native",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/engine-native/src",
  "projectType": "library",
  "tags": ["gpu"],
  "targets": {
    "build-native": {
      "command": "node scripts/build.mjs",
      "options": {
        "cwd": "packages/engine-native"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/native/**/*",
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/tools/native/**/*",
        {
          "externalDependencies": ["node-api-headers"]
        },
        {
          "env": "FDW_FROM_SOURCE"
        }
      ],
      "outputs": [
        "{projectRoot}/build/fdw_native.node",
        "{projectRoot}/build/.prebuilt"
      ],
      "configurations": {
        "debug": {
          "args": "--debug"
        }
      }
    },
    "test": {
      "dependsOn": [
        "build-native",
        {
          "projects": ["engine-vulkan"],
          "target": "build-native"
        }
      ],
      "inputs": [
        "default",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/*.node",
          "transitive": true
        },
        {
          "env": "VULKAN_SDK"
        },
        {
          "env": "DISPLAY"
        },
        {
          "env": "FDW_REQUIRE_SUITES"
        },
        {
          "env": "FDW_D3D12_ADAPTER"
        },
        {
          "env": "VK_DRIVER_FILES"
        }
      ]
    }
  }
}
