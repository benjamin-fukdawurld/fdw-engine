<% layout("@base", it) %>

<%~ block("vertex-input", () => { %>
<%~ include("@vertex-attributes", { attributes: it.material?.attributes }) %>
<% }) %>

<%~ block("vertex-output", () => { %>
struct VertexOutput {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) fragPosition: vec3<f32>,
    @location(1) normal: vec3<f32>,
    @location(2) uv: vec2<f32>
};
<% }) %>

<%~ block("uniforms", () => { %>
<%~ include("@uniforms", { uniforms: it.material.frameUniforms, group: 0 }) %>
<%~ include("@uniforms", { uniforms: it.material.materialUniforms, group: 1 }) %>
<%~ include("@textures", { textures: it.material.textures, group: 1, bindingOffset: it.material.materialUniforms.length }) %>
<%~ include("@uniforms", { uniforms: it.material.objectUniforms, group: 2 }) %>
<% }) %>

<%~ block("functions", () => { %>
<%~ include("@functions") %>
<% }) %>

<%~ block("vertex-params", () => { %>
<%- if (it.material?.attributes?.length) {-%>
    in: VertexInput
<%- } -%>
<% }) %>

<%~ block("vertex-shader", () => { %>
    var out: VertexOutput;
    let worldPosition = modelMatrix * vec4<f32>(in.position, 1.0);
    out.clip_position = projectionMatrix * viewMatrix * worldPosition;
    out.fragPosition = worldPosition.xyz;
    out.normal = normalMatrix * in.normal;
    out.uv = in.uv;
    return out;
<% }) %>

<%~ block("fragment-shader", () => { %>
    let normal = normalize(in.normal);
    let lightDir = normalize(lightPosition - in.fragPosition);
    let viewDir = normalize(cameraPosition - in.fragPosition);
    let resultColor = getLighting(
      normal,
      lightDir,
      viewDir,
      diffuseLightColor,
      specularLightColor,
      <% if (it.uv) { %>
      in.uv
      <% } %>
    );

    return vec4<f32>(resultColor, 1.0);
<% }) %>