fn getAmbientColor(
<% if (it.uv) { %>
  uv: vec2<f32>,
<% } %>
) -> vec3<f32> {
    var result = <%~ it.ambientColor ?? 'vec3<f32>(1.0, 1.0, 1.0)' %>;
    <% if (it.ambientTexture) { %>
    result = result
      * textureSample(
        <%= it.ambientTexture %>,
        <%= it.ambientTextureSampler %>,
        uv
      ).rgb;
    <% } %>

    return result;
}

fn getDiffuseColor(
<% if (it.uv) { %>
  uv: vec2<f32>,
<% } %>
) -> vec3<f32> {
    var result = <%~ it.diffuseColor ?? 'vec3<f32>(1.0, 1.0, 1.0)' %>;
    <% if (it.diffuseTexture) { %>
    result = result
      * textureSample(
        <%= it.diffuseTexture %>,
        <%= it.diffuseTextureSampler %>,
        uv
      ).rgb;
    <% } %>
    
    return result;
}

fn getSpecularColor(
<% if (it.uv) { %>
  uv: vec2<f32>,
<% } %>
) -> vec3<f32> {
    var result = <%~ it.specularColor ?? 'vec3<f32>(1.0, 1.0, 1.0)' %>;
    <% if (it.specularTexture) { %>
    result = result
      * textureSample(
        <%= it.specularTexture %>,
        <%= it.specularTextureSampler %>,
        uv
      ).rgb;
    <% } %>
    
    return result;
}

fn getShininess(
<% if (it.uv) { %>
  uv: vec2<f32>,
<% } %>
) -> f32 {
    var result = 32.0;
    <% if (it.shininess != null) { %>
    result = <%= it.shininess %>;
    <% } %>

    <% if (it.shininessTexture) { %>
    // The texture stores the exponent normalized to [0, 1]: it replaces the
    // uniform value instead of scaling it.
    result = textureSample(
        <%= it.shininessTexture %>,
        <%= it.shininessTextureSampler %>,
        uv
      ).<%= it.shininessTextureChannel ?? 'r' %> * 255.0;
    <% } %>

    // pow(x, 0.0) is 1 (and pow(0.0, 0.0) is undefined): an exponent below 1
    // would turn the whole surface into a white highlight.
    return max(result, 1.0);
}

fn getAmbientLighting(
  ambientColor: vec3<f32>,
  diffuseColor: vec3<f32>
) -> vec3<f32> {
    return diffuseColor * ambientColor;
}

fn getDiffuseLighting(
  normal: vec3<f32>,
  lightDirection: vec3<f32>,
  diffuseColor: vec3<f32>,
  diffuseLightColor: vec3<f32>
) -> vec3<f32> {
    let diff = max(dot(normal, lightDirection), 0.0);
    return diff * diffuseColor * diffuseLightColor;
}

fn getSpecularLighting(
  normal: vec3<f32>,
  lightDirection: vec3<f32>,
  viewDirection: vec3<f32>,
  specularColor: vec3<f32>,
  specularLightColor: vec3<f32>,
  shininess: f32
) -> vec3<f32> {
    let reflectDir = reflect(-lightDirection, normal);
    let spec = pow(max(dot(viewDirection, reflectDir), 0.0), shininess);
    // No highlight on faces turned away from the light.
    let facing = select(0.0, 1.0, dot(normal, lightDirection) > 0.0);
    return facing * spec * specularColor * specularLightColor;
}

fn getLighting(
  normal: vec3<f32>,
  lightDirection: vec3<f32>,
  viewDirection: vec3<f32>,
  diffuseLightColor: vec3<f32>,
  specularLightColor: vec3<f32>,
  <% if (it.uv) { %>
  uv: vec2<f32>,
  <% } %>
) -> vec3<f32> {
    let ambientColor = getAmbientColor(<% if (it.uv) { %>uv<% } %>);
    let diffuseColor = getDiffuseColor(<% if (it.uv) { %>uv<% } %>);
    let specularColor = getSpecularColor(<% if (it.uv) { %>uv<% } %>);
    let shininess = getShininess(<% if (it.uv) { %>uv<% } %>);

    let ambient = getAmbientLighting(ambientColor, diffuseColor);
    let diffuse = getDiffuseLighting(normal, lightDirection, diffuseColor, diffuseLightColor);
    let specular = getSpecularLighting(normal, lightDirection, viewDirection, specularColor, specularLightColor, shininess);

    return ambient + diffuse + specular;
}