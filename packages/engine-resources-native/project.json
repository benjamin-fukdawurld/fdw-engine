{
  "name": "engine-resources-native",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/engine-resources-native/src",
  "projectType": "library",
  "tags": ["gpu"],
  "targets": {
    "test": {
      "dependsOn": [
        {
          "projects": ["engine-native"],
          "target": "build-native"
        }
      ],
      "inputs": [
        "default",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/*.node",
          "transitive": true
        },
        {
          "env": "FDW_REQUIRE_SUITES"
        }
      ]
    }
  }
}
