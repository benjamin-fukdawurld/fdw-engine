{
  "name": "engine-vulkan",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/engine-vulkan/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        {
          "env": "VULKAN_SDK"
        }
      ],
      "dependsOn": ["build-native"]
    },
    "build-native": {
      "command": "node scripts/build.mjs",
      "options": {
        "cwd": "packages/engine-vulkan"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/native/**/*",
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/tools/native/**/*",
        {
          "env": "VULKAN_SDK"
        }
      ],
      "outputs": ["{projectRoot}/build/fdw_vulkan.node"]
    }
  }
}
