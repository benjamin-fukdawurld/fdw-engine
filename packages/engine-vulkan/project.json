{
  "name": "engine-vulkan",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/engine-vulkan/src",
  "projectType": "library",
  "tags": ["gpu"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/*.node",
          "transitive": true
        },
        {
          "env": "VULKAN_SDK"
        },
        {
          "env": "FDW_REQUIRE_SUITES"
        },
        {
          "env": "VK_DRIVER_FILES"
        }
      ],
      "dependsOn": ["build-native"]
    },
    "build-native": {
      "command": "node scripts/build.mjs",
      "options": {
        "cwd": "packages/engine-vulkan"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/native/**/*",
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/tools/native/**/*",
        {
          "externalDependencies": ["node-api-headers"]
        },
        {
          "env": "FDW_FROM_SOURCE"
        },
        {
          "env": "VULKAN_SDK"
        }
      ],
      "outputs": [
        "{projectRoot}/build/fdw_vulkan.node",
        "{projectRoot}/build/.prebuilt",
        "{projectRoot}/build/dxcompiler.dll",
        "{projectRoot}/build/libdxcompiler.so"
      ],
      "configurations": {
        "debug": {
          "args": "--debug"
        }
      }
    }
  }
}
