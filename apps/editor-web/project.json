{
  "name": "editor-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/editor-web/src",
  "projectType": "application",
  "// tags": "gpu: its tests render in Chromium, in the native job of the CI",
  "tags": ["gpu"],
  "targets": {
    "build-docs": {
      "// command": "The editor in the site of the documentation, under /fdw-engine/editor-app/: its pages show it (apps/docs)",
      "command": "vite build --base /fdw-engine/editor-app/ --outDir ../docs/public/editor-app --emptyOutDir",
      "options": {
        "cwd": "apps/editor-web",
        "env": {
          "FDW_MODELS": "/fdw-engine/models/"
        }
      },
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/apps/docs/public/editor-app"]
    }
  }
}
