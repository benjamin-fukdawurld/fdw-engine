{
  "compilerOptions": {
    "composite": true,
    "target": "es2023",
    "lib": ["es2023", "DOM", "ESNext.Disposable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "electron-vite/node", "@webgpu/types"],
    "customConditions": ["@fdw-engine/source"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/engine/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ]
}
