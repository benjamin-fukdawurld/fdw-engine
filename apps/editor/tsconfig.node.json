{
  "compilerOptions": {
    "composite": true,
    "target": "es2023",
    "lib": ["es2023", "DOM", "ESNext.Disposable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "electron-vite/node", "@webgpu/types"],
    "customConditions": ["@fdw-engine/source"],
    // @fdw/editor-ui would otherwise resolve the React types of the
    // repository: two copies of @types/react, whose types are unrelated.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "tests/**/*",
    "scripts/**/*.ts",
    "src/main/**/*",
    "src/engine/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ]
}
