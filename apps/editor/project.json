{
  "name": "editor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/editor/src",
  "projectType": "application",
  "// tags": "gpu: its tests run Electron on Vulkan, in the native job of the CI",
  "tags": ["gpu"],
  "targets": {
    "build-native": {
      "command": "node scripts/build-native.mjs",
      "options": {
        "cwd": "apps/editor"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/native/**/*",
        "{projectRoot}/tests/*.c",
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/tools/native/**/*"
      ],
      "outputs": [
        "{projectRoot}/build/fdw_editor.node",
        "{projectRoot}/build/xprobe",
        "{projectRoot}/build/winprobe.exe"
      ]
    },
    "install": {
      "// command": "npm install, then the binary of Electron: its postinstall does not run under the npm of the CI (scripts not approved)",
      "command": "npm install && node node_modules/electron/install.js",
      "options": {
        "cwd": "apps/editor"
      }
    },
    "dev": {
      "executor": "nx:run-script",
      "options": {
        "script": "dev"
      },
      "continuous": true,
      "dependsOn": [
        "build-native",
        {
          "projects": ["engine-native", "engine-vulkan", "engine-d3d12"],
          "target": "build-native"
        }
      ]
    },
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/packages/*/src/**/*",
        "!{projectRoot}/out/**/*"
      ],
      "outputs": ["{projectRoot}/out"],
      "dependsOn": ["install", "^build"]
    },
    "preview": {
      "executor": "nx:run-script",
      "options": {
        "script": "preview"
      },
      "dependsOn": [
        "build-native",
        {
          "projects": ["engine-native", "engine-vulkan", "engine-d3d12"],
          "target": "build-native"
        },
        "build"
      ],
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": {
        "script": "typecheck"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/packages/*/src/**/*",
        "!{projectRoot}/out/**/*"
      ],
      "dependsOn": ["install"]
    },
    "package": {
      "// command": "the executable (scripts/package.mjs): the programs precompiled on this device",
      "command": "node scripts/package.mjs",
      "options": {
        "cwd": "apps/editor"
      },
      "dependsOn": [
        "install",
        "build-native",
        {
          "projects": ["engine-native", "engine-vulkan", "engine-d3d12"],
          "target": "build-native"
        },
        "build"
      ]
    },
    "test": {
      "command": "node scripts/test.mjs",
      "options": {
        "cwd": "apps/editor"
      },
      "dependsOn": [
        "install",
        "build-native",
        {
          "projects": ["engine-native", "engine-vulkan", "engine-d3d12"],
          "target": "build-native"
        },
        "build"
      ]
    }
  }
}
