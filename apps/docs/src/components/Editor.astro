---
// The web editor, live, in a frame: the one of apps/editor-web, built into
// the site under /editor-app/ (editor-web:build-docs), its engine on WebGPU or
// WebGL2 as the live examples (?backend=webgl2 forces it). Nothing is kept
// from a visit to the next (?embed): the default layout each time. For the
// tests, ?level=minimal gives the game its smallest level (a terrain
// without forest, one orc): its graphs without loading the whole game.
interface Props {
  // The scene shown first: the level by default.
  scene?: string;
  // A panel shown at the start: an editor of graphs.
  view?: string;
  // The docks shown (left, right, bottom): all of them by default.
  docks?: string[];
  // The height of the frame, in pixels. Default 600.
  height?: number;
}

const { scene, view, docks, height = 600 } = Astro.props;
// The pages in French say it in French.
const fr = Astro.currentLocale === 'fr';
const title = fr ? "L'éditeur de FdwEngine" : 'The FdwEngine editor';
const open = fr
  ? "Ouvrir l'éditeur dans une page à lui"
  : 'Open the editor in a page of its own';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/editor-app/`;
const query = new URLSearchParams({ embed: '' });
if (scene) query.set('scene', scene);
if (view) query.set('view', view);
if (docks) query.set('docks', docks.join(','));
---

<div class="fdw-editor" data-editor>
  <iframe
    title={title}
    data-src={`${base}?${query}`}
    style={`height: ${height}px`}
    allow="fullscreen"></iframe>
  <p class="fdw-example-status">
    <a href={base} target="_blank">{open}</a>
  </p>
</div>

<script>
  // The backend and the level of the page given to the frame; loaded once
  // near the screen.
  const page = new URLSearchParams(window.location.search);
  const forced = page.get('backend');
  const level = page.get('level');
  const frames = document.querySelectorAll<HTMLIFrameElement>(
    '[data-editor] iframe'
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const frame = entry.target as HTMLIFrameElement;
        if (!entry.isIntersecting || frame.src) continue;
        const url = new URL(frame.dataset['src'] ?? '', window.location.href);
        if (forced) url.searchParams.set('backend', forced);
        if (level) url.searchParams.set('level', level);
        frame.src = url.href;
        observer.unobserve(frame);
      }
    },
    { rootMargin: '200px' }
  );
  frames.forEach((frame) => observer.observe(frame));
</script>
