{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "dev": {
      "command": "astro dev",
      "options": {
        "cwd": "apps/docs"
      },
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["editor-web"],
          "target": "build-docs"
        }
      ]
    },
    "build": {
      "command": "astro build",
      "options": {
        "cwd": "apps/docs"
      },
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "projects": ["editor-web"],
          "target": "build-docs"
        }
      ]
    },
    "preview": {
      "command": "astro preview",
      "options": {
        "cwd": "apps/docs"
      },
      "dependsOn": ["build"],
      "continuous": true
    },
    "visual": {
      "command": "playwright test",
      "options": {
        "cwd": "apps/docs"
      },
      "dependsOn": ["build"]
    }
  }
}
