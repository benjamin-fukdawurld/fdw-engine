{
  "name": "rendering-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tests/rendering/src",
  "projectType": "library",
  "tags": ["type:test"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        {
          "env": "VULKAN_SDK"
        }
      ],
      "dependsOn": [
        {
          "projects": ["engine-vulkan"],
          "target": "build-native"
        }
      ]
    }
  }
}
