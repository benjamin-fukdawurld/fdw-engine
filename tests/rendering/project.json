{
  "name": "rendering-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tests/rendering/src",
  "projectType": "library",
  "tags": ["type:test", "gpu"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/*.node",
          "transitive": true
        },
        {
          "env": "VULKAN_SDK"
        },
        {
          "env": "FDW_REQUIRE_SUITES"
        },
        {
          "env": "FDW_D3D12_ADAPTER"
        },
        {
          "env": "VK_DRIVER_FILES"
        }
      ],
      "dependsOn": [
        {
          "projects": ["engine-vulkan", "engine-d3d12"],
          "target": "build-native"
        }
      ]
    }
  }
}
