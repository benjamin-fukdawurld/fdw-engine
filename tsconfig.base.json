{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "ESNext.Disposable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@fdw-engine/source"],
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["packages/ui/src/components/ui/*"],
      "@/lib/*": ["packages/ui/src/lib/*"],
      "@fdw/engine-backend": ["packages/engine-backend/src/index.ts"],
      "@fdw/engine-core": ["packages/engine-core/src/index.ts"],
      "@fdw/engine-webgpu": ["packages/engine-webgpu/src/index.ts"],
      "@fdw/engine-shader": ["packages/engine-shader/src/index.ts"],
      "@fdw/engine-webgl2": ["packages/engine-webgl2/src/index.ts"],
      "@fdw/engine-native": ["packages/engine-native/src/index.ts"],
      "@fdw/demo-scenes": ["packages/demo-scenes/src/index.ts"],
      "@fdw/engine-vulkan": ["packages/engine-vulkan/src/index.ts"],
      "@fdw/engine-d3d12": ["packages/engine-d3d12/src/index.ts"],
      "@fdw/engine-geometry": ["packages/engine-geometry/src/index.ts"],
      "@fdw/engine-scene": ["packages/engine-scene/src/index.ts"],
      "@fdw/engine-occlusion": ["packages/engine-occlusion/src/index.ts"],
      "@fdw/engine-tessellation": ["packages/engine-tessellation/src/index.ts"],
      "@fdw/engine-camera": ["packages/engine-camera/src/index.ts"],
      "@fdw/engine-input": ["packages/engine-input/src/index.ts"],
      "@fdw/engine-input-web": ["packages/engine-input-web/src/index.ts"],
      "@fdw/engine-input-native": ["packages/engine-input-native/src/index.ts"],
      "@fdw/engine-resources": ["packages/engine-resources/src/index.ts"],
      "@fdw/engine-resources-web": [
        "packages/engine-resources-web/src/index.ts"
      ],
      "@fdw/engine-resources-native": [
        "packages/engine-resources-native/src/index.ts"
      ],
      "@fdw/engine-assets": ["packages/engine-assets/src/index.ts"],
      "@fdw/engine-obj": ["packages/engine-obj/src/index.ts"],
      "@fdw/engine-gltf": ["packages/engine-gltf/src/index.ts"],
      "@fdw/engine-ktx2": ["packages/engine-ktx2/src/index.ts"],
      "@fdw/engine-graph": ["packages/engine-graph/src/index.ts"],
      "@fdw/engine-graph-editing": [
        "packages/engine-graph-editing/src/index.ts"
      ],
      "@fdw/engine-animation": ["packages/engine-animation/src/index.ts"],
      "@fdw/engine-behavior": ["packages/engine-behavior/src/index.ts"],
      "@fdw/engine-noise": ["packages/engine-noise/src/index.ts"],
      "@fdw/engine-ocean": ["packages/engine-ocean/src/index.ts"],
      "@fdw/engine-fluids": ["packages/engine-fluids/src/index.ts"],
      "@fdw/engine-raytracing": ["packages/engine-raytracing/src/index.ts"],
      "@fdw/engine-editing": ["packages/engine-editing/src/index.ts"],
      "@fdw/engine-scene-io": ["packages/engine-scene-io/src/index.ts"],
      "@fdw/engine-skinning": ["packages/engine-skinning/src/index.ts"],
      "@fdw/engine-physics": ["packages/engine-physics/src/index.ts"],
      "@fdw/engine-physics-rapier": [
        "packages/engine-physics-rapier/src/index.ts"
      ],
      "@fdw/engine-audio": ["packages/engine-audio/src/index.ts"],
      "@fdw/engine-audio-web": ["packages/engine-audio-web/src/index.ts"],
      "@fdw/engine-audio-native": ["packages/engine-audio-native/src/index.ts"]
    }
  }
}
